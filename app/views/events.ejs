<%- include('partials/header') %>
<section class="page-heading container"><p class="eyebrow">Come curious. Leave connected.</p><div class="section-heading"><div><h1>Community events</h1><p class="lead">New ideas are closer when we come together.</p></div><% if (user?.role === 'admin') { %><a href="#create-event" class="button"><i data-lucide="plus"></i> Create event</a><% } %></div></section>
<section class="container section compact"><h2>Coming up</h2><% if (events.length) { %><div class="event-grid"><% events.forEach(event => { %><%- include('partials/event-card', { event }) %><% }) %></div><% } else { %><div class="empty-state"><i data-lucide="calendar-days"></i><h3>Our next gathering is on its way.</h3><p>No upcoming events just yet. Check back soon or get in touch about hosting a session.</p><a href="/contact" class="text-link">Start a conversation <i data-lucide="arrow-up-right"></i></a></div><% } %></section>
<% if (pastEvents.length) { %><section class="container section compact"><h2>Past events</h2><div class="event-grid"><% pastEvents.forEach(event => { %><%- include('partials/event-card', { event }) %><% }) %></div></section><% } %>
<% if (user?.role === 'admin') { %><section id="create-event" class="container section ruled"><div class="content-narrow"><p class="eyebrow">Administrator</p><h2>Create an event</h2><%- include('partials/event-form') %></div></section><% } %>
<%- include('partials/footer') %>