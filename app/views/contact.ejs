<%- include('partials/header') %>
<section class="container section split-layout"><div><p class="eyebrow">Contact us</p><h1>Let&apos;s start<br>a conversation<span class="accent">.</span></h1><p class="lead">Have a question, an idea for a session, or a reason to collaborate? We would love to hear from you.</p><div class="contact-detail"><i data-lucide="map-pin"></i><div><strong>Our home</strong><p>Manila, Philippines</p></div></div><div class="contact-detail"><i data-lucide="messages-square"></i><div><strong>Your message matters</strong><p>Our community organizers will review your inquiry and reply to the email you provide.</p></div></div></div><div class="form-surface"><h2>Say hello</h2><form method="post" action="/contact"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><label>Name<input name="name" autocomplete="name" value="<%= user?.name ?? '' %>" required minlength="2" maxlength="80"></label><label>Email<input name="email" type="email" autocomplete="email" value="<%= user?.email ?? '' %>" required maxlength="254"></label><label>Subject<input name="subject" required minlength="3" maxlength="120"></label><label>Your message<textarea name="message" rows="5" required minlength="10" maxlength="5000"></textarea></label><p class="fine-print">We store your contact details and message so the organizers can respond to your inquiry.</p><button class="button">Send message <i data-lucide="send"></i></button></form></div></section>
<%- include('partials/footer') %>