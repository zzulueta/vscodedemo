<%- include('partials/header') %>
<section class="hero">
  <img class="hero-image" src="/assets/manila.jpg" alt="Sunset over Manila, viewed from Intramuros" fetchpriority="high">
  <div class="container hero-content">
    <p class="eyebrow light"><span class="status-dot"></span>A global community. A Manila heartbeat.</p>
    <h1>Global AI<br><span>Philippines</span></h1>
    <p class="hero-description">Curious minds. Real connections.<br>Let&apos;s explore what AI can be, together.</p>
    <div class="button-row"><a class="button" href="/events">Explore events <i data-lucide="arrow-up-right"></i></a><a class="hero-link" href="/about">Meet the community <i data-lucide="arrow-right"></i></a></div>
    <div class="hero-caption"><i data-lucide="map-pin"></i>Manila, Philippines <span>14.5995&deg; N &nbsp; 120.9842&deg; E</span></div>
  </div>
</section>
<div class="community-strip"><div class="container"><span><i data-lucide="users-round"></i> Open to every curious mind</span><span><i data-lucide="code-xml"></i> Learn by building</span><span><i data-lucide="globe-2"></i> Part of the Global AI Community</span></div></div>
<section class="section container">
  <div class="section-heading"><div><p class="eyebrow">Make room for your next idea</p><h2>Meet. Learn. Build.</h2></div><a class="text-link" href="/events">All events <i data-lucide="arrow-up-right"></i></a></div>
  <% if (events.length) { %><div class="event-grid"><% events.forEach(event => { %><%- include('partials/event-card', { event }) %><% }) %></div>
  <% } else { %><div class="empty-event"><div class="calendar-art" aria-hidden="true"><i data-lucide="calendar-heart"></i></div><div><span class="tag">The next chapter is coming</span><h3>Good things start with a gathering.</h3><p>Our next events will appear here. Join the community and be part of what comes next.</p></div><a href="/signup" class="button secondary">Join the community <i data-lucide="arrow-up-right"></i></a></div><% } %>
</section>
<section class="about-band"><div class="container about-layout"><div><p class="eyebrow">Rooted in Manila. Open to the world.</p><h2>AI is better<br>when we share it.</h2></div><div><p class="lead">A place for developers, students, creators, and the simply curious to connect through artificial intelligence.</p><p>We bring people together to exchange ideas, build practical skills, and make new possibilities feel a little closer to home.</p><a class="text-link" href="/about">Get to know us <i data-lucide="arrow-up-right"></i></a></div><img src="/assets/logo.png" alt="Global AI Manila chapter emblem featuring Manila Cathedral" width="220" height="269" loading="lazy"></div></section>
<section class="section container"><p class="eyebrow">There is a place for you here</p><div class="values-grid"><div><span class="number">01</span><i data-lucide="sparkles"></i><h3>Follow your curiosity</h3><p>Start with a question. Discover new perspectives with people who are learning, too.</p></div><div><span class="number">02</span><i data-lucide="blocks"></i><h3>Make something real</h3><p>Turn ideas into experiments through hands-on learning and shared experience.</p></div><div><span class="number">03</span><i data-lucide="messages-square"></i><h3>Find your people</h3><p>Connect with Manila&apos;s AI community and keep the conversation going.</p></div></div></section>
<%- include('partials/footer') %>