<%- include('partials/header') %>
<section class="container section auth-layout"><div class="auth-intro"><p class="eyebrow">Your people. Your possibilities.</p><h1><%= title %><span class="accent">.</span></h1><p class="lead"><%= signup ? 'A new connection starts with a hello.' : 'Good to have you here again.' %></p><img src="/assets/logo.png" alt="Global AI Manila community emblem" width="200" height="244"></div><div class="form-surface"><h2><%= signup ? 'Create your profile' : 'Sign in' %></h2><form action="<%= signup ? '/signup' : '/login' %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if (signup) { %><label>Name<input name="name" autocomplete="name" required minlength="2" maxlength="80"></label><% } %><label>Email<input type="email" name="email" autocomplete="email" required maxlength="254"></label><label>Password <span class="muted"><%= signup ? '(12 or more characters)' : '' %></span><input type="password" name="password" autocomplete="<%= signup ? 'new-password' : 'current-password' %>" required <%- signup ? 'minlength="12"' : '' %> maxlength="128"></label><% if (signup) { %><label>A little about you <span class="muted">(optional)</span><textarea name="bio" rows="3" maxlength="500" placeholder="What are you curious about?"></textarea></label><p class="fine-print">Your profile and event registrations are stored for community administration. Contact us to request account assistance or data removal.</p><% } %><button class="button full-width"><%= signup ? 'Join Global AI Manila' : 'Sign in' %> <i data-lucide="arrow-up-right"></i></button></form><p class="auth-switch"><%= signup ? 'Already part of the community?' : 'New here?' %> <a href="<%= signup ? '/login' : '/signup' %>"><%= signup ? 'Sign in' : 'Create a profile' %></a></p><% if (!signup) { %><a class="fine-print" href="/contact">Need account assistance?</a><% } %></div></section>
<%- include('partials/footer') %>