<%- include('partials/header') %>
<section class="page-heading container"><a href="/events" class="text-link"><i data-lucide="arrow-left"></i> All events</a><p class="eyebrow"><%= event.format %></p><h1><%= event.title %></h1><div class="event-meta"><span><i data-lucide="calendar-days"></i><%= date(event.startsAt) %> PHT</span><span><i data-lucide="map-pin"></i><%= event.location %></span></div></section>
<section class="container section compact split-layout"><div><h2>About this event</h2><p class="preserve"><%= event.description %></p></div><aside class="registration-panel"><h2>Your place in the room</h2><% if (registration) { %><span class="tag <%= registration.status %>"><%= registration.status %></span><p><%= registration.status === 'approved' ? 'You are on the list. See you at the event!' : registration.status === 'rejected' ? 'Your registration was not approved. Contact the organizers with any questions.' : 'Your request is with the organizers. Check your profile for the decision.' %></p><a href="/profile" class="text-link">Your registrations <i data-lucide="arrow-right"></i></a><% } else if (isPast) { %><p>This event has ended. Explore upcoming events to find your next gathering.</p><% } else if (!user) { %><p>Join the community or sign in to request a place.</p><a href="/login" class="button">Sign in to register <i data-lucide="arrow-up-right"></i></a><a href="/signup" class="text-link spaced">Create your profile</a><% } else { %><p>Register as <strong><%= user.name %></strong></p><form action="/events/<%= event.id %>/register" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Anything you would like us to know? <span class="muted">(optional)</span><textarea name="note" maxlength="1000" rows="4"></textarea></label><label class="checkbox-label"><input type="checkbox" required> I agree to share my profile name and email with the organizers for this registration.</label><button class="button">Request a place <i data-lucide="arrow-up-right"></i></button></form><% } %></aside></section>
<%- include('partials/footer') %>