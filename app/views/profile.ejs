<%- include('partials/header') %>
<section class="container page-heading"><p class="eyebrow">Your community space</p><h1>Hello, <%= user.name %><span class="accent">.</span></h1></section>
<section class="container section compact split-layout"><div><h2>Your profile</h2><form method="post" action="/profile"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Name<input name="name" value="<%= user.name %>" required minlength="2" maxlength="80"></label><label>Email<input type="email" value="<%= user.email %>" readonly></label><label>Short bio<textarea name="bio" rows="4" maxlength="500"><%= user.bio %></textarea></label><button class="button"><i data-lucide="save"></i> Save profile</button></form><details class="spaced"><summary>Change password</summary><form action="/profile/password" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Current password<input type="password" name="currentPassword" required autocomplete="current-password" maxlength="128"></label><label>New password (12 or more characters)<input type="password" name="password" required minlength="12" maxlength="128" autocomplete="new-password"></label><button class="button secondary">Update password</button></form></details></div><div><h2>Your registrations</h2><% if (!registrations.length) { %><div class="empty-state"><i data-lucide="ticket"></i><h3>Your next connection is waiting.</h3><p>You haven&apos;t registered for an event yet.</p><a href="/events" class="text-link">Explore events <i data-lucide="arrow-up-right"></i></a></div><% } %><% registrations.forEach(registration => { %><article class="registration-row"><span class="tag <%= registration.status %>"><%= registration.status %></span><h3><a href="/events/<%= registration.eventId %>"><%= registration.eventTitle %></a></h3><p>Requested <%= date(registration.createdAt) %> PHT</p></article><% }) %></div></section>
<%- include('partials/footer') %>