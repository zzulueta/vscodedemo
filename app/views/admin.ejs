<%- include('partials/header') %>
<section class="container page-heading"><p class="eyebrow">Administrator</p><div class="section-heading"><h1>Community desk</h1><a href="/events#create-event" class="button"><i data-lucide="plus"></i> Create event</a></div><div class="stats-row"><div><strong><%= events.length %></strong><span>Events</span></div><div><strong><%= registrations.filter(item => item.status === 'pending').length %></strong><span>Awaiting review</span></div><div><strong><%= inquiries.filter(item => item.status === 'new').length %></strong><span>New inquiries</span></div></div></section>
<section class="container section compact"><h2>Event registrations</h2><% if (!registrations.length) { %><p class="empty-line">No registrations yet.</p><% } else { %><div class="table-scroll"><table><thead><tr><th>Member</th><th>Event</th><th>Status</th><th>Review</th></tr></thead><tbody><% registrations.forEach(registration => { %><tr><td><strong><%= registration.name %></strong><span class="table-detail"><%= registration.email %></span><% if (registration.note) { %><p class="table-note"><%= registration.note %></p><% } %></td><td><a href="/events/<%= registration.eventId %>"><%= registration.eventTitle %></a></td><td><span class="tag <%= registration.status %>"><%= registration.status %></span></td><td><% if (registration.status === 'pending') { %><form action="/admin/registrations/<%= registration.eventId %>/<%= registration.id %>/decision" method="post" class="button-row"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="icon-button approve" name="status" value="approved" aria-label="Approve registration for <%= registration.name %>" title="Approve registration"><i data-lucide="check"></i></button><button class="icon-button reject" name="status" value="rejected" aria-label="Reject registration for <%= registration.name %>" title="Reject registration"><i data-lucide="x"></i></button></form><% } else { %><span class="muted">Reviewed</span><% } %></td></tr><% }) %></tbody></table></div><% } %></section>
<section class="container section ruled"><h2>Contact inbox</h2><% if (!inquiries.length) { %><p class="empty-line">Your inbox is clear.</p><% } %><% inquiries.forEach(inquiry => { %><article class="inquiry"><div class="section-heading"><div><span class="tag"><%= inquiry.status %></span><h3><%= inquiry.subject %></h3><p><%= inquiry.name %> &middot; <a href="mailto:<%= inquiry.email %>"><%= inquiry.email %></a> &middot; <%= date(inquiry.createdAt) %> PHT</p></div><% if (inquiry.status === 'new') { %><form method="post" action="/admin/inquiries/<%= inquiry.id %>/resolve"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button secondary small"><i data-lucide="check-check"></i> Mark resolved</button></form><% } %></div><p class="preserve"><%= inquiry.message %></p><a class="text-link" href="mailto:<%= inquiry.email %>">Reply by email <i data-lucide="arrow-up-right"></i></a></article><% }) %></section>
<%- include('partials/footer') %>